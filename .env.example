# Copy this file to `.env` (in the project root) and fill in your own values.
# `.env` is listed in .gitignore, so your real credentials never reach Git.

# Required by day10 (PostgreSQL)
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Optional - these are the defaults day10 uses if you leave them out
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heroes_db
